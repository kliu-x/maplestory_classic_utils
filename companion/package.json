{
  "name": "mcw-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MapleStory Classic World companion: training, builds and sourced game data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "data:fetch": "node scripts/fetch-mcw-data.mjs",
    "data:build": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
